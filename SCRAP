"date":"2026-08-17","line":"Door C","shift":"Night","model":"FB_BM","defect":"คราบโฟมด้านซ้าย","qty":2},{"date":"2026-08-17","line":"Door C","shift":"Night","model":"FB_BM","defect":"ฝาบุบ","qty":3},{"date":"2026-08-17","line":"Door C","shift":"Night","model":"FB_BM","defect":"โฟมรั่ว P5","qty":10},{"date":"2026-08-17","line":"Door C","shift":"Night","model":"FB_BM","defect":"โฟมรั่ว P6","qty":7},{"date":"2026-08-17","line":"Door C","shift":"Night","model":"RL_BM","defect":"ฝาในบวม","qty":3},{"date":"2026-08-17","line":"Door C","shift":"Night","model":"R_FUF","defect":"ขอบม้วน","qty":5},{"date":"2026-08-17","line":"Door C","shift":"Night","model":"R_FUF","defect":"ฝานูน","qty":5},{"date":"2026-08-17","line":"Door C","shift":"Night","model":"R_FUF","defect":"ฝาบุบ","qty":3},{"date":"2026-08-17","line":"Door C","shift":"Night","model":"R_FUF","defect":"ฝาในบวม","qty":2},{"date":"2026-08-17","line":"Door C","shift":"Night","model":"VEG_BM","defect":"คราบโฟมด้านขวา","qty":5},{"date":"2026-08-17","line":"Door C","shift":"Night","model":"VEG_BM","defect":"คราบโฟมด้านซ้าย","qty":5},{"date":"2026-08-17","line":"Door C","shift":"Night","model":"VEG_BM","defect":"ฝาบุบ","qty":7},{"date":"2026-08-17","line":"Door C","shift":"Night","model":"VEG_BM","defect":"โฟมรั่ว P5","qty":7},{"date":"2026-08-17","line":"Door C","shift":"Night","model":"VEG_BM","defect":"โฟมรั่ว P6","qty":6}];

const LINES = ["Door A","Door B","Door C"];
const SHIFTS = ["Day","Night"];
const TARGET_NG = 2.5, TARGET_FTR = 100 - TARGET_NG;
const MIN_DATE = RAW_OUTPUT[0].date;
const MAX_DATE = RAW_OUTPUT.reduce((m,r)=>r.date>m?r.date:m, MIN_DATE);
const MODELS = [...new Set(RAW_OUTPUT.map(r=>r.model))].sort();
const DEFECT_TYPES = [...new Set(RAW_DEFECTS.map(r=>r.defect))].sort();
const MONTHS = [...new Set(RAW_OUTPUT.map(r=>r.date.slice(0,7)))].sort();
const DOOR_COLOR = {"Door A":"#5b9bff","Door B":"#2f6fed","Door C":"#7dd3fc"};
const C = {blue:"#2f6fed",blue2:"#5b9bff",good:"#22c55e",warn:"#eab308",bad:"#ef4444",muted:"#8792ab",border:"#212a40",panel2:"#131a2c"};

const $ = id => document.getElementById(id);
const fmt = n => Math.round(n).toLocaleString("en-US");
const sum = (a,k) => a.reduce((s,r)=>s+r[k],0);
const statusColor = f => f>=TARGET_FTR ? C.good : f>=TARGET_FTR-1 ? C.warn : C.bad;

// ---- filter state ----
const S = {line:"all",shift:"all",model:"all",defect:"all",gran:"week",start:MIN_DATE,end:MAX_DATE};

function fillSelect(el, items){ el.innerHTML = items.map(([v,l])=>`<option value="${v}">${l}</option>`).join(""); }
fillSelect($("fLine"), [["all","All Doors"],...LINES.map(l=>[l,l])]);
fillSelect($("fShift"), [["all","All Shifts"],...SHIFTS.map(s=>[s,s])]);
fillSelect($("fModel"), [["all","All Models"],...MODELS.map(m=>[m,m])]);
fillSelect($("fDefect"), [["all","All Defect Types"],...DEFECT_TYPES.map(d=>[d,d])]);
fillSelect($("fMonth"), [["all","All Months"],...MONTHS.map(m=>[m,m])]);
$("fStart").min=$("fEnd").min=MIN_DATE; $("fStart").max=$("fEnd").max=MAX_DATE;
$("fStart").value=MIN_DATE; $("fEnd").value=MAX_DATE;
$("range").textContent = `${MIN_DATE} — ${MAX_DATE} • Door A / B / C`;
$("targetBadge").textContent = `Target ≥ ${TARGET_FTR.toFixed(1)}%`;

$("fLine").onchange = e => {S.line=e.target.value; render();};
$("fShift").onchange = e => {S.shift=e.target.value; render();};
$("fModel").onchange = e => {S.model=e.target.value; render();};
$("fDefect").onchange = e => {S.defect=e.target.value; render();};
$("fGran").onchange = e => {S.gran=e.target.value; render();};
$("fStart").onchange = e => {S.start=e.target.value||MIN_DATE; $("fMonth").value="all"; render();};
$("fEnd").onchange = e => {S.end=e.target.value||MAX_DATE; $("fMonth").value="all"; render();};
$("fMonth").onchange = e => {
  const m = e.target.value;
  if(m==="all"){ S.start=MIN_DATE; S.end=MAX_DATE; }
  else { S.start=m+"-01"; const d=new Date(+m.slice(0,4), +m.slice(5,7), 0); S.end=m+"-"+String(d.getDate()).padStart(2,"0"); }
  if(S.start<MIN_DATE) S.start=MIN_DATE; if(S.end>MAX_DATE) S.end=MAX_DATE;
  $("fStart").value=S.start; $("fEnd").value=S.end; render();
};
$("reset").onclick = () => {
  Object.assign(S,{line:"all",shift:"all",model:"all",defect:"all",gran:"week",start:MIN_DATE,end:MAX_DATE});
  ["fLine","fShift","fModel","fDefect","fMonth"].forEach(i=>$(i).value="all");
  $("fGran").value="week"; $("fStart").value=MIN_DATE; $("fEnd").value=MAX_DATE; render();
};

function bucket(dateStr, g){
  const d = new Date(dateStr+"T00:00:00");
  if(g==="day") return d.toLocaleDateString("en-GB",{day:"2-digit",month:"2-digit"});
  if(g==="week"){ const m=new Date(d); m.setDate(m.getDate()-((m.getDay()+6)%7)); return "W "+m.toLocaleDateString("en-GB",{day:"2-digit",month:"2-digit"}); }
  return d.toLocaleDateString("en-GB",{month:"short",year:"2-digit"});
}

// ---- charts ----
Chart.defaults.color = C.muted;
Chart.defaults.borderColor = C.border;
Chart.defaults.font.family = "Inter, 'Noto Sans Thai', sans-serif";
const common = {responsive:true,maintainAspectRatio:false,animation:{duration:400}};
const mk = (id, cfg) => new Chart($(id), cfg);

const cFtr = mk("cFtr",{type:"line",data:{labels:[],datasets:LINES.map(l=>({label:l,data:[],borderColor:DOOR_COLOR[l],backgroundColor:DOOR_COLOR[l],borderWidth:2,pointRadius:0,tension:.25,spanGaps:true}))},
  options:{...common,interaction:{mode:"index",intersect:false},scales:{y:{max:100,ticks:{callback:v=>v+"%"}},x:{grid:{display:false},ticks:{maxTicksLimit:14}}},plugins:{legend:{labels:{boxWidth:10}}}}});

const cProd = mk("cProd",{data:{labels:[],datasets:[
  {type:"line",label:"Production",data:[],borderColor:C.blue,backgroundColor:"rgba(47,111,237,.25)",fill:true,borderWidth:2,pointRadius:0,tension:.25,yAxisID:"y"},
  {type:"line",label:"Defect",data:[],borderColor:C.bad,backgroundColor:C.bad,borderWidth:2,pointRadius:0,tension:.25,yAxisID:"y1"}]},
  options:{...common,interaction:{mode:"index",intersect:false},scales:{y:{position:"left"},y1:{position:"right",grid:{display:false}},x:{grid:{display:false},ticks:{maxTicksLimit:14}}},plugins:{legend:{labels:{boxWidth:10}}}}});

const cPareto = mk("cPareto",{data:{labels:[],datasets:[
  {type:"bar",label:"Qty",data:[],backgroundColor:[],borderRadius:3,yAxisID:"y"},
  {type:"line",label:"Cumulative %",data:[],borderColor:C.warn,backgroundColor:C.warn,borderWidth:2,pointRadius:3,yAxisID:"y1"}]},
  options:{...common,scales:{y:{position:"left"},y1:{position:"right",min:0,max:100,grid:{display:false},ticks:{callback:v=>v+"%"}},x:{grid:{display:false},ticks:{font:{size:10},maxRotation:50,minRotation:35}}},plugins:{legend:{display:false}}}});

const donutCfg = () => ({type:"doughnut",data:{labels:LINES,datasets:[{data:[0,0,0],backgroundColor:LINES.map(l=>DOOR_COLOR[l]),borderColor:"#0d1220",borderWidth:3}]},
  options:{...common,cutout:"65%",plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>` ${c.label}: ${fmt(c.parsed)}`}}}}});
const cProdShare = mk("cProdShare", donutCfg());
const cDefShare = mk("cDefShare", donutCfg());

function gaugeSVG(value, size=170){
  const r=size/2-14, circ=2*Math.PI*r, off=circ*(1-Math.max(0,Math.min(100,value))/100), col=statusColor(value);
  return `<svg width="${size}" height="${size}" viewBox="0 0 ${size} ${size}">
    <circle cx="${size/2}" cy="${size/2}" r="${r}" stroke="#131a2c" stroke-width="14" fill="none"/>
    <circle cx="${size/2}" cy="${size/2}" r="${r}" stroke="${col}" stroke-width="14" fill="none" stroke-linecap="round"
      stroke-dasharray="${circ}" stroke-dashoffset="${off}" transform="rotate(-90 ${size/2} ${size/2})" style="transition:stroke-dashoffset .6s"/>
    <text x="50%" y="47%" text-anchor="middle" dominant-baseline="middle" fill="#fff" font-family="Poppins,sans-serif" font-weight="700" font-size="${size*0.21}">${value.toFixed(1)}</text>
    <text x="50%" y="64%" text-anchor="middle" dominant-baseline="middle" fill="#8792ab" font-family="IBM Plex Mono,monospace" font-size="${size*0.075}">% FTR</text></svg>`;
}
function heatColor(v,max){ const t=max?Math.min(1,v/max):0; return `rgb(${Math.round(13+t*226)},${Math.round(18+t*50)},${Math.round(32+t*36)})`; }

// ---- main render ----
function render(){
  const base = r => r.date>=S.start && r.date<=S.end && (S.shift==="all"||r.shift===S.shift) && (S.model==="all"||r.model===S.model);
  const outAll = RAW_OUTPUT.filter(r=>base(r) && (S.line==="all"||r.line===S.line));
  const defAll = RAW_DEFECTS.filter(r=>base(r) && (S.line==="all"||r.line===S.line) && (S.defect==="all"||r.defect===S.defect));
  const outNL = RAW_OUTPUT.filter(base);
  const defNL = RAW_DEFECTS.filter(r=>base(r) && (S.defect==="all"||r.defect===S.defect));

  // KPI
  const P = sum(outAll,"output"), D = sum(defAll,"qty");
  const rate = P ? D/P*100 : 0, ftr = 100-rate;
  const kp = (k,v,u,c) => `<div class="kpi" style="border-top-color:${c}"><div class="k">${k}</div><div class="v">${v}<small>${u}</small></div></div>`;
  $("kpis").innerHTML =
    kp("Total Production",fmt(P),"pcs",C.blue) + kp("Total Defect",fmt(D),"pcs",C.bad) +
    kp("FTR %",ftr.toFixed(2),"%",statusColor(ftr)) + kp("Defect Rate %",rate.toFixed(2),"%",statusColor(ftr)) +
    kp("Models",new Set(outAll.map(r=>r.model)).size,"models",C.blue2) + kp("Production Lines",new Set(outAll.map(r=>r.line)).size,"lines",C.blue2);

  // Doors (ignore door filter so A/B/C can always be compared)
  const doors = LINES.map(l=>{
    const o=sum(outNL.filter(r=>r.line===l),"output"), d=sum(defNL.filter(r=>r.line===l),"qty");
    return {line:l,output:o,defect:d,ftr:o?100-d/o*100:100};
  });
  $("gauges").innerHTML = doors.map(d=>`<div class="gauge">${gaugeSVG(d.ftr)}<div class="n">${d.line}</div><div class="s">${fmt(d.output)} pcs • ${fmt(d.defect)} NG</div></div>`).join("");

  // Shares
  const TO = sum(doors,"output"), TD = sum(doors,"defect");
  cProdShare.data.datasets[0].data = doors.map(d=>d.output); cProdShare.update();
  cDefShare.data.datasets[0].data = doors.map(d=>d.defect); cDefShare.update();
  const lg = (key,T) => doors.map(d=>`<div><span><span class="dot" style="background:${DOOR_COLOR[d.line]}"></span>${d.line}</span><b>${T?(d[key]/T*100).toFixed(1):"0.0"}%</b></div>`).join("");
  $("lgProd").innerHTML = lg("output",TO); $("lgDef").innerHTML = lg("defect",TD);

  // FTR trend per door
  const gl = {day:"Daily",week:"Weekly",month:"Monthly"}[S.gran];
  $("tFtr").textContent = `FTR Trend by Door (${gl})`; $("tProd").textContent = `Production & Defect Trend (${gl})`;
  const B = {};
  outNL.forEach(r=>{ const k=bucket(r.date,S.gran); (B[k]=B[k]||{d:r.date,o:{},f:{}}); B[k].o[r.line]=(B[k].o[r.line]||0)+r.output; if(r.date<B[k].d)B[k].d=r.date; });
  defNL.forEach(r=>{ const k=bucket(r.date,S.gran); if(B[k]) B[k].f[r.line]=(B[k].f[r.line]||0)+r.qty; });
  const keys = Object.keys(B).sort((a,b)=>B[a].d>B[b].d?1:-1);
  cFtr.data.labels = keys;
  LINES.forEach((l,i)=>{ cFtr.data.datasets[i].data = keys.map(k=>B[k].o[l]? +(100-(B[k].f[l]||0)/B[k].o[l]*100).toFixed(2):null); });
  cFtr.update();

  // Production & defect trend (respects door filter)
  const T = {};
  outAll.forEach(r=>{ const k=bucket(r.date,S.gran); (T[k]=T[k]||{d:r.date,p:0,f:0}); T[k].p+=r.output; if(r.date<T[k].d)T[k].d=r.date; });
  defAll.forEach(r=>{ const k=bucket(r.date,S.gran); if(T[k]) T[k].f+=r.qty; });
  const tk = Object.keys(T).sort((a,b)=>T[a].d>T[b].d?1:-1);
  cProd.data.labels = tk; cProd.data.datasets[0].data = tk.map(k=>T[k].p); cProd.data.datasets[1].data = tk.map(k=>T[k].f); cProd.update();

  // Pareto / top defects (share base = total defect → 100%)
  const dm = {}; defAll.forEach(r=>dm[r.defect]=(dm[r.defect]||0)+r.qty);
  let cum=0;
  const par = Object.entries(dm).sort((a,b)=>b[1]-a[1]).map(([name,qty])=>{ const pct=D?qty/D*100:0; cum+=pct; return {name,qty,pct,cum}; });
  const top10 = par.slice(0,10);
  cPareto.data.labels = top10.map(p=>p.name);
  cPareto.data.datasets[0].data = top10.map(p=>p.qty);
  cPareto.data.datasets[0].backgroundColor = top10.map((_,i)=>i===0?C.bad:C.blue);
  cPareto.data.datasets[1].data = top10.map(p=>+p.cum.toFixed(2));
  cPareto.update();
  $("top5").innerHTML = par.slice(0,5).map(p=>`<tr><td>${p.name}</td><td class="r">${fmt(p.qty)}</td><td class="r" style="color:${C.blue2}">${p.pct.toFixed(1)}%</td><td class="r" style="color:${C.warn}">${p.cum.toFixed(1)}%</td></tr>`).join("") || `<tr><td colspan="4" style="color:var(--muted)">ไม่มีข้อมูล</td></tr>`;

  // Heatmap Door x Defect
  const hd = par.slice(0,10).map(p=>p.name);
  const mat = LINES.map(l=>hd.map(n=>sum(defNL.filter(r=>r.line===l&&r.defect===n),"qty")));
  const hmax = Math.max(1,...mat.flat());
  $("heat").innerHTML = `<table><thead><tr><th>Door</th>${hd.map(n=>`<th class="v">${n}</th>`).join("")}</tr></thead><tbody>` +
    LINES.map((l,i)=>`<tr><td style="color:var(--text);white-space:nowrap;padding-right:8px">${l}</td>${mat[i].map(v=>`<td style="background:${heatColor(v,hmax)};color:${v/hmax>.5?"#fff":C.muted}">${v||""}</td>`).join("")}</tr>`).join("") + `</tbody></table>`;

  // Model breakdown
  const M = {};
  const gm = m => M[m] = M[m] || {model:m,o:0,d:0,lines:new Set(),t:{}};
  outAll.forEach(r=>{ const m=gm(r.model); m.o+=r.output; m.lines.add(r.line); });
  defAll.forEach(r=>{ const m=gm(r.model); m.d+=r.qty; m.t[r.defect]=(m.t[r.defect]||0)+r.qty; });
  const rows = Object.values(M).sort((a,b)=>b.o-a.o);
  $("modelBadge").textContent = rows.length+" models";
  $("models").innerHTML = rows.map(m=>{
    const f = m.o?100-m.d/m.o*100:100, top = Object.entries(m.t).sort((a,b)=>b[1]-a[1])[0];
    const c = statusColor(f);
    return `<tr class="click ${S.model===m.model?"sel":""}" data-m="${m.model}"><td>${m.model}</td><td style="color:var(--muted)">${[...m.lines].join(", ")}</td><td class="r">${fmt(m.o)}</td><td class="r">${fmt(m.d)}</td><td class="r" style="color:${c}">${f.toFixed(2)}%</td><td class="r" style="color:${c}">${(100-f).toFixed(2)}%</td><td style="color:var(--muted)">${top?top[0]:"-"}</td></tr>`;
  }).join("");
  document.querySelectorAll("#models tr.click").forEach(tr=>tr.onclick=()=>{ S.model = (S.model===tr.dataset.m)?"all":tr.dataset.m; $("fModel").value=S.model; render(); });
}
render();
</script>
</body>
